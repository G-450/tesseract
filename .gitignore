# Datasets
datasets/raw/*
datasets/processed/*
datasets/interim/*
datasets/cache/*
datasets/metadata/*
!datasets/**/.gitkeep

# Model Outputs & Experiments
outputs/
# Experiment artifacts are generated; only the layout doc is tracked.
# 'experiments/*' rather than 'experiments/' so git still descends into
# the directory and can see the negation below.
experiments/*
!experiments/README.md
*.pkl
*.pt
*.pth

# Python Caches & Virtual Environments
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.env

# IDEs and Editors
.idea/
.vscode/
*.swp
pyrightconfig.json

# Testing and Type checking
.pytest_cache/
.mypy_cache/

# Jupyter Notebooks
.ipynb_checkpoints/

# Local scripts and presentations
explainable_cgcnn_project_presentation/
plot_metrics.py
# Cygwin/Git Bash crash artifacts
*.stackdump
